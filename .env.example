# Used only to sign the httpOnly app session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Private owner-only login entry point (proxy.ts rewrites this exact path to
# the real login screen). Set to a long, non-obvious slug, e.g.
# hk-os-access-<random-string>. Never commit the real value. Changing it
# requires a redeploy (env vars are read at request time, not build time,
# but Node/Vercel processes only pick up new values after a restart).
PRIVATE_ADMIN_LOGIN_PATH=
# Used to sign/encrypt customer OAuth state and OAuth session cookies
# (falls back to ADMIN_SESSION_SECRET/SUPABASE_SERVICE_ROLE_KEY if unset).
OAUTH_STATE_SECRET=
BOOTSTRAP_ADMIN_SECRET=
FORCE_BOOTSTRAP_ADMIN=false
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
CUSTOMER_NAME=
CUSTOMER_COMPANY_ID=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Playwright (tests/e2e) — a real, dedicated test admin account. Never point
# these at a production account; authenticated coverage skips cleanly when
# unset (see tests/e2e/fixtures/qa-auth.ts).
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
# Customer-isolation Playwright tests (tests/e2e/customer-isolation.spec.ts) —
# two seeded test-customer accounts in a dedicated non-production environment.
QA_CUSTOMER_A_EMAIL=
QA_CUSTOMER_A_PASSWORD=
QA_CUSTOMER_B_DOCUMENT_ID=
QA_CUSTOMER_B_REPORT_ID=

# HK AI Smart Router — Gemini is the active production provider (required
# for AI features to work). Do not expose these to the browser.
GEMINI_API_KEY=
# Kept for the admin-only rollback path (src/lib/openai-client.ts) — not
# required for normal production operation now that Gemini is primary.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional/dormant multi-provider integrations — not on the automatic
# production path, reachable only via explicit admin override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
MANUS_API_KEY=
MANUS_API_BASE_URL=
MANUS_API_ENDPOINT=
GOOGLE_MAPS_API_KEY=
GOOGLE_API_KEY=

# Optional — HK AI Workforce Director provider override. One of the existing
# AgentProviderKey values (openai/anthropic/gemini/groq/manus/openrouter/
# ollama). Leave unset to use the existing auto-routing priority list.
AI_WORKFORCE_DIRECTOR_PROVIDER=

# Optional report email delivery through Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
REPORT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional future backend integrations.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=https://www.hkdijital.com.tr

# Runtime / platform flags.
NODE_ENV=
VERCEL=
CRON_SECRET=
AGENT_HUB_CRON_SECRET=
DISCORD_WEBHOOK_URL=

# HK Autonomous Agency OS — hard safety defaults. Do not flip to true without
# a real, tested write-capable provider integration (none exists yet for
# either flag as of this build).
AUTO_APPLY_AD_CHANGES=false
AUTO_SEND_OUTREACH=false

# Meta / Facebook integrations. Keep non-public values server-side only.
NEXT_PUBLIC_META_PIXEL_ID=
META_DATASET_ID=
META_ACCESS_TOKEN=
META_AD_LIBRARY_ACCESS_TOKEN=
META_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INTEGRATION_TOKEN_SECRET=
INTEGRATION_ENCRYPTION_KEY=

# Google Ads / GA4 integrations. Keep private key escaped with \n in Vercel.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
# DEPRECATED — Google sunset developer tokens on 2026-09-09. Google Ads API
# access is now determined by the Google Cloud project behind
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET below, not by a separate token; the
# developer-token header is optional and ignored by Google's servers. Kept
# here only for any older external references — sending it does nothing,
# and its absence no longer blocks Google Ads discovery/sync.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
NEXT_PUBLIC_GTM_ID=

# Customer OAuth connect flow (src/lib/customer-integration-oauth.ts) — the
# real "Hesap Bağla" flow in /musteri-paneli (CustomerAccountConnectCenter)
# that customers use to connect their OWN Instagram/Facebook/Google/YouTube/
# Google Ads/Google Business Profile accounts. Distinct from the app-level
# keys above (those are for HK Dijital's OWN accounts / server-to-server
# calls). Used by the Analiz & Raporlama Merkezi (Analytics Center) to read
# each customer's connected assets and sync their platform analytics.
# Falls back to META_APP_ID/META_APP_SECRET above if these two are unset.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=
# DEPRECATED — no longer affects the actual OAuth request (kept only for
# any older external references). See META_BUSINESS_CLIENT_ID below.
META_ADVANCED_SCOPES_ENABLED=false
# Facebook/Instagram organic analytics (pages_show_list, pages_read_engagement,
# instagram_basic, instagram_manage_insights) require a DEDICATED, separate
# Meta App from META_APP_ID above. Confirmed live: META_APP_ID's own Meta
# Dashboard "Add use cases" screen shows no more use cases available for it
# (Meta app types are immutable, and this app was created as a Consumer-type
# app — Facebook Login for Business / Instagram Graph API are Business-type-
# only use cases). These three variables are an atomic, all-or-nothing unit —
# a partially-set trio is treated as fully absent (never mixed with
# META_APP_ID) so a client_id/config_id mismatch is structurally impossible:
#   1. Create a NEW Meta App, type "Business".
#   2. Add the "Instagram API with Facebook Login" / "Facebook Login for
#      Business" use case (exact name may vary by Meta Dashboard version).
#   3. Facebook Login for Business → Configurations → Create configuration →
#      User access token → select the Pages/Instagram assets it needs →
#      select permissions: pages_show_list, pages_read_engagement,
#      instagram_basic, instagram_manage_insights (verify against
#      developers.facebook.com/docs/graph-api/reference/page/insights and
#      the Instagram Graph API insights docs whether your target endpoints
#      also require read_insights or another permission before finalizing
#      this list — do not assume these four are exhaustive without
#      checking). Do not add business_management/ads_read unless Meta Ads
#      analytics is also genuinely needed.
#   4. Register this app's own redirect URI (same value as META_REDIRECT_URI)
#      under this NEW app's Valid OAuth Redirect URIs.
#   5. Copy this new app's App ID / App Secret / Configuration ID below.
# See docs/analytics-center/setup.md for the full walkthrough.
META_BUSINESS_CLIENT_ID=
META_BUSINESS_CLIENT_SECRET=
META_LOGIN_CONFIG_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# HMAC signing key for the OAuth state parameter (CSRF protection). Falls
# back to NEXTAUTH_SECRET / SUPABASE_SERVICE_ROLE_KEY / META_APP_SECRET if
# unset — set explicitly in production for a value dedicated to this.
OAUTH_STATE_SECRET=

# HK Growth Intelligence: IndexNow key (any string you choose) — must also be
# hosted at https://<host>/<key>.txt, which src/app/[indexnowKey]/route.ts
# serves automatically once this is set.
INDEXNOW_KEY=

# Optional behavior analytics. Keep these server-side unless public script support is intentionally added.
MICROSOFT_CLARITY_PROJECT_ID=
HOTJAR_SITE_ID=

# Agency Benchmarking — external (cross-agency) benchmark stays opt-in and
# anonymous-aggregate-only even when true; no participant pool exists yet.
EXTERNAL_BENCHMARK_ENABLED=false

# Social Autopilot — official Instagram (Meta) Login API credentials for HK
# Dijital's OWN Instagram account. Deliberately separate from META_APP_ID/
# META_APP_SECRET above (those are a different OAuth flow/redirect/scope set
# used to connect a CUSTOMER's ad account) — this can point at the same Meta
# Developer App (with the Instagram Login product added) or a different one.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=
# Optional — defaults to the current Graph API version used by
# src/lib/social-autopilot/instagram-graph-client.ts if unset.
INSTAGRAM_GRAPH_API_VERSION=
# Master kill switch: real Instagram publishing only ever runs when this is
# exactly "true" AND NODE_ENV=production AND the workspace's own settings
# (test_mode off, no emergency pause, autopilot active) all agree. Leave
# unset/false during development — Social Autopilot's test mode stays fully
# usable either way (see src/lib/social-autopilot/publication-safety.ts).
INSTAGRAM_PUBLISH_ENABLED=false

# Social Autopilot — Claude MCP connector (local-only by default; `npm run
# mcp` / `npm run mcp:http`, see .mcp.json). Token/text-encryption reuses
# INTEGRATION_ENCRYPTION_KEY above; no separate secret is needed for that.
# SOCIAL_MCP_TRANSPORT: stdio (default, Claude Code/Desktop local config) or
# http (Streamable HTTP — local testing or a real remote deployment).
SOCIAL_MCP_TRANSPORT=stdio
# SOCIAL_MCP_MODE: READ_ONLY, ASSISTED (default) or FULL_CONTROL — gates
# which tool permission tiers this connector is allowed to attempt at all;
# application-wide production/test-mode checks apply independently on top.
SOCIAL_MCP_MODE=ASSISTED
# Only read for the http transport; binds loopback-only by default.
SOCIAL_MCP_HOST=127.0.0.1
SOCIAL_MCP_PORT=3300
# Required (32+ random characters) only when SOCIAL_MCP_TRANSPORT=http.
SOCIAL_MCP_AUTH_SECRET=
# Optional — only set for a real remote HTTP deployment of this connector.
SOCIAL_MCP_PUBLIC_BASE_URL=
