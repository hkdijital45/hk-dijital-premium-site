<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HKDijital</AssemblyName>
    <RootNamespace>HKDijital</RootNamespace>
    <ApplicationIcon Condition="Exists('..\\..\\shared\\icons\\AppIcon.ico')">..\\..\\shared\\icons\\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\\..\\shared\\desktop-config.json" Link="desktop-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
